ARG CONFIG_ENCRYPTION_PRIVATE_KEY
ARG CONFIG_ENCRYPTION_ALGORITHM
ARG INFRA_VERSION

FROM --platform=linux/amd64 lukemathwalker/cargo-chef:latest as chef
WORKDIR /app

FROM --platform=linux/amd64 chef AS planner
COPY ./config ./config
COPY ./rust/Cargo.toml ./rust/Cargo.lock ./rust/
COPY ./rust ./rust
WORKDIR /app/rust
RUN cargo chef prepare --bin=syncer --recipe-path recipe.json

FROM --platform=linux/amd64 chef AS builder

ENV CONFIG_ENCRYPTION_PRIVATE_KEY=${CONFIG_ENCRYPTION_PRIVATE_KEY}
ENV CONFIG_ENCRYPTION_ALGORITHM=${CONFIG_ENCRYPTION_ALGORITHM}
ENV INFRA_VERSION=${INFRA_VERSION}

WORKDIR /app/rust
COPY --from=planner /app/rust/recipe.json ./recipe.json
RUN cargo chef cook --release --recipe-path ./recipe.json --bin=syncer

WORKDIR /app
COPY ./config ./config
WORKDIR /app/rust
COPY ./rust ./
RUN cargo build --release -p syncer
RUN mv ./target/release/syncer ./app

FROM --platform=linux/amd64 debian:stable-slim AS runtime
WORKDIR /app
COPY --from=builder /app/rust/app /usr/local/bin/
RUN apt-get update && apt install -y openssl ca-certificates
ENTRYPOINT ["/usr/local/bin/app"]
